{
  "name": "ARMAPay",
  "short_name": "ARMAPay",
  "description": "UPI-style payments with a built-in Undo for payments you suspect are fraud.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EDF1F0",
  "theme_color": "#0A4A44",
  "categories": ["finance"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Pay someone", "short_name": "Pay", "url": "/?action=pay", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Undo a payment", "short_name": "Undo", "url": "/?action=undo", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
