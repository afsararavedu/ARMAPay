# Copy to .env and export before starting (the server reads process.env directly).
PORT=3000
HOST=127.0.0.1
DB_FILE=data/armapay.db
SANDBOX=1            # 1 = simulated banks and demo contacts. 0 = no simulated money (needs a real bank integration)
UNDO_WINDOW_MIN=15   # how long a payment can be undone instantly
UNDO_ABUSE_LIMIT=3   # undos per window before the next one goes to manual review
UNDO_ABUSE_DAYS=30
COLLECT_TTL_HOURS=24 # a "pay me" request expires if the payer does nothing
PIN_MAX_FAILS=3
PIN_LOCK_SEC=30      # production: hours, not seconds
SESSION_DAYS=7
COOKIE_SECURE=0      # set to 1 behind HTTPS
TZ_OFFSET_MIN=330    # for the daily limit boundary (330 = IST)

# --- Hosted deployment (server.js) ---
# HOST=0.0.0.0                       # default in server.js
# PORT=3000                          # default in server.js
# DB_FILE=/home/u123456789/armapay-data/armapay.db   # default: ~/armapay-data/armapay.db. Keep it OUTSIDE the app folder
# TRUST_PROXY=1                      # number of reverse proxies in front (Hostinger: 1)
# SQLITE_DRIVER=node                 # force Node's built-in SQLite instead of better-sqlite3

# --- Forgot password (OTP by SMS) ---
SMS_PROVIDER=console                 # console (log only) | twilio | webhook. Real users need twilio or webhook
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=+1xxxxxxxxxx           # or TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
# SMS_WEBHOOK_URL=https://your-gateway.example.com/send   # POST {"to":"+91...","mobile":"...","message":"..."}
# SMS_WEBHOOK_TOKEN=xxxxxxxx         # sent as "Authorization: Bearer ..."
OTP_TTL_MIN=10                       # how long an OTP works
OTP_MAX_ATTEMPTS=5                   # wrong tries before the OTP is burned
OTP_RESEND_SEC=30                    # wait between OTP requests
OTP_PER_HOUR=5                       # OTP requests per number per hour
# DEMO_SHOW_OTP=1                    # DEMO ONLY: shows the OTP on screen. Anyone could then reset any account. Never on a public site

# --- Scan & pay: QR safety check ---
QR_CHECK_TTL_MIN=15                  # how long a QR check stays valid for paying
QR_REPORTER_MIN_HOURS=0              # production: 24 or more, so brand-new fake accounts cannot smear a merchant
